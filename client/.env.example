# ── Where the MediThink API is ──────────────────────────────────────────────
# Leave empty to call the API on the same address as the app:
#   - development (npm run dev): Vite forwards /api to API_PROXY_TARGET below
#   - production: the server serves this build, so /api is the same address
# Set it when the API lives somewhere else, e.g. https://api.example.com
# (no trailing slash). Rebuild the app after changing it.
VITE_API_BASE_URL=

# Development only: where `npm run dev` forwards /api when the base URL above is empty.
API_PROXY_TARGET=http://localhost:4100
