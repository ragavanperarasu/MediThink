# ── Required ────────────────────────────────────────────────────────────────
# The MongoDB holding the admin account and analysed reports.
MONGODB_URI=mongodb://127.0.0.1:27017/medithink

# Signs the session cookie. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The model that reads reports and answers questions.
OPENAI_API_KEY=

# ── Admin account ───────────────────────────────────────────────────────────
# Written to MongoDB at every boot, so changing these and restarting is how the
# password is changed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@1234

# ── Optional ────────────────────────────────────────────────────────────────
# ANALYSIS_MODEL=gpt-5.6-luna
# ANALYSIS_TIMEOUT_MS=120000
# PORT=4100
# STORAGE_DIR=./uploads
# MAX_UPLOAD_MB=40
# TIMEZONE=Asia/Kolkata
# TRUST_PROXY=0
# NODE_ENV=production

# "Continue with Google": the OAuth 2.0 web client ID from Google Cloud Console.
# Add your site (e.g. http://localhost:5180) under Authorised JavaScript origins.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# LandingAI ADE — turns each uploaded PDF into text, tables and page boxes.
# Key: https://va.landing.ai/settings/api-key (EU: https://va.eu-west-1.landing.ai/settings/api-key)
LANDINGAI_API_KEY=
# EU accounts: https://api.va.eu-west-1.landing.ai
LANDINGAI_BASE_URL=https://api.va.landing.ai
LANDINGAI_MODEL=dpt-2-latest

# ── Voice ───────────────────────────────────────────────────────────────────
# Read-aloud voice (OpenAI). off = use only the phone's own voice.
TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer
TTS_VOICE=nova
# Speech to text for the mic (OpenAI). off = use only the browser's own listening.
STT_MODEL=gpt-transcribe

# ── Frontend on another address ─────────────────────────────────────────────
# App addresses allowed to call this API (comma-separated). Empty when the app
# and API share one address (local development). e.g. https://app.example.com
CORS_ORIGINS=
